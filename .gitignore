# ---- Rust build output ----
/target/
**/*.rs.bk
*.pdb

# ---- External tool binaries (214 MB; fetched by scripts/fetch_tools.ps1) ----
/bin/
/dist/

# ---- Runtime state: databases, WAL, backups ----
/data/omni.db
/data/omni.db-shm
/data/omni.db-wal
/data/backups/
/data/adblock/
/data/benchmarks/
/data/secrets.bin

# ---- Runtime working directories ----
/temp/
/logs/
/archive/
/watchfolder/

# ---- SECRETS: live config holds mailbox credentials, never commit ----
# Any config*.json at the root (config.json, config.local.json, backups);
# only the example is published.
/config*.json
!/config.example.json
*.bak.json
.env
.env.*
*.env
!/.env.example
# Local overrides of any config, in any directory.
config.local.*
*.local.json
*.pem
*.key
*.pfx
*.p12
# DPAPI secret store and any database copy, wherever it lands (a trial run
# puts both next to its own config).
secrets.bin
*.keystore
*.jks
*.kdbx
# OAuth token caches (MSAL, azure-identity), should a tool ever write one.
*token_cache*
*.msalcache*
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# Browser cookie exports: cookies.txt, and the extension naming
# x.com_cookies.txt / www.youtube.com_cookies.txt (plan P3.5 jars).
*cookies*.txt
*.cookies
*.log

# ---- Real mail and newsroom media: never in a public repo ----
# Golden fixtures are invented and are the only mail that is tracked.
*.eml
*.msg
!/crates/omni-email/tests/fixtures/*.eml
*.mxf
*.mp4
*.mov
*.mkv

# ---- Generated reports ----
/benchmark_results.json
/benchmark_results.md

# ---- Editor / OS ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# ---- Real newsroom roster: staff names and work addresses ----
journalists.seed.json

# ---- Internal working notes and agent instructions ----
#
# These are how the work gets done, not part of what ships. They name internal
# defect ids, the station's own conventions and the order the hardening is being
# carried out in; none of that is useful to someone reading the repository, and
# some of it would go stale the moment it was published. README.md is the one
# Markdown file that is deliberately tracked.
/AGENTS.md
/CLAUDE.md
/SKILL.md
/plan.md
/handoffs.md
/HANDOFF.md
/benchmark_results.md
/.claude/
/.cursor/
/.github/copilot-instructions.md
/.windsurfrules
/.aider*
