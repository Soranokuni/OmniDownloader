# Microsoft Graph settings for a console or development run (plan P4.9).
#
# The daemon does not read this file. Set the variables in the shell that
# starts it, for example in PowerShell:
#
#   $env:OMNI_GRAPH_TENANT_ID     = "your_tenant_id_here"
#   $env:OMNI_GRAPH_CLIENT_ID     = "your_client_id_here"
#   $env:OMNI_GRAPH_MAILBOX       = "ingest@example.gr"
#   $env:OMNI_GRAPH_CLIENT_SECRET = "your_client_secret_here"
#   $env:OMNI_LLM_API_KEY          = "your_llm_api_key_here"   # online LLM only
#   .\target\release\omni-ingest.exe run
#
# A set variable wins over config.json and the encrypted secret store, and is
# never written to either. For the Windows service, use config.json plus
# `omni-ingest secrets set graph.client_secret` instead: a service's
# environment is stored in plaintext in the registry.
#
# Copy to .env for your own notes if you like; .env is gitignored. Never
# commit real values.

OMNI_GRAPH_TENANT_ID=your_tenant_id_here
OMNI_GRAPH_CLIENT_ID=your_client_id_here
OMNI_GRAPH_MAILBOX=ingest@example.gr
OMNI_GRAPH_CLIENT_SECRET=your_client_secret_here
OMNI_LLM_API_KEY=your_llm_api_key_here
